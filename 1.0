(function (thisObj) {
    var entries = [];   // 扁平列表 [{comp, layer}]
    var scope = "project"; // "project" 或 "comp"

    function ae2ui(t) { return String(t).replace(/\r\n/g, "\n").replace(/\r/g, "\n"); }
    function ui2ae(t) { return String(t).replace(/\r\n/g, "\n").replace(/\n/g, "\r"); }

    function getText(layer) {
        try {
            var st = layer.property("Source Text");
            if (!st) return "";
            if (st.isTimeVarying) return ae2ui(st.keyValue(1).text);
            return ae2ui(st.value.text);
        } catch (e) { return ""; }
    }

    function setText(layer, txt) {
        try {
            var st = layer.property("Source Text");
            if (!st) return false;
            var aeText = ui2ae(txt);
            if (st.isTimeVarying) {
                for (var k = 1; k <= st.numKeys; k++) {
                    var td = st.keyValue(k);
                    td.text = aeText;
                    st.setValueAtKey(k, td);
                }
            } else {
                var td2 = st.value;
                td2.text = aeText;
                st.setValue(td2);
            }
            return true;
        } catch (e) { return false; }
    }

    // ==================== 窗口 ====================
    var win = (thisObj instanceof Panel)
        ? thisObj
        : new Window("palette", "文本批量替换", undefined, { resizeable: true });

    win.orientation = "column";
    win.alignChildren = ["fill", "top"];
    win.spacing = 8;
    win.margins = 12;

    // 顶部工具条
    var topBar = win.add("group");
    topBar.alignment = ["fill", "top"];
    topBar.alignChildren = ["left", "center"];
    topBar.spacing = 8;

    topBar.add("statictext", undefined, "范围：");
    var scopeDrop = topBar.add("dropdownlist", undefined, ["整个项目", "当前合成"]);
    scopeDrop.selection = 0;

    var countLabel = topBar.add("statictext", undefined, "");
    var spacer = topBar.add("statictext", undefined, "");
    spacer.alignment = ["fill", "center"];
    var refreshBtn = topBar.add("button", undefined, "刷新");
    var clearBtn = topBar.add("button", undefined, "清空译文");

    // 主体
    var main = win.add("group");
    main.orientation = "row";
    main.alignment = ["fill", "fill"];
    main.alignChildren = ["fill", "fill"];
    main.spacing = 8;

    var leftGroup = main.add("group");
    leftGroup.orientation = "column";
    leftGroup.alignment = ["fill", "fill"];
    leftGroup.alignChildren = ["fill", "top"];
    leftGroup.spacing = 4;
    leftGroup.add("statictext", undefined, "原文（Ctrl+A 全选 → 复制 → 去翻译）");
    var leftBox = leftGroup.add("edittext", undefined, "", { multiline: true });
    leftBox.preferredSize = [430, 500];

    var rightGroup = main.add("group");
    rightGroup.orientation = "column";
    rightGroup.alignment = ["fill", "fill"];
    rightGroup.alignChildren = ["fill", "top"];
    rightGroup.spacing = 4;
    rightGroup.add("statictext", undefined, "译文（整段粘贴回来，保留 <<<数字>>> 标记）");
    var rightBox = rightGroup.add("edittext", undefined, "", { multiline: true });
    rightBox.preferredSize = [430, 500];

    // 底部
    var bottomBar = win.add("group");
    bottomBar.alignment = ["fill", "bottom"];
    bottomBar.alignChildren = ["center", "center"];
    bottomBar.spacing = 12;

    var applyBtn = bottomBar.add("button", undefined, "应用全部修改");
    applyBtn.preferredSize = [220, 28];

    // ==================== 收集图层 ====================
    function collectEntries() {
        entries = [];
        var compCount = 0;

        if (scope === "comp") {
            var comp = app.project.activeItem;
            if (!(comp instanceof CompItem)) {
                return { ok: false, msg: "当前没有激活的合成，请先打开一个合成。" };
            }
            for (var i = 1; i <= comp.numLayers; i++) {
                var lyr = comp.layer(i);
                if (lyr instanceof TextLayer) entries.push({ comp: comp, layer: lyr });
            }
            compCount = 1;
        } else {
            for (var p = 1; p <= app.project.numItems; p++) {
                var item = app.project.item(p);
                if (item instanceof CompItem) {
                    compCount++;
                    for (var j = 1; j <= item.numLayers; j++) {
                        var lyr2 = item.layer(j);
                        if (lyr2 instanceof TextLayer) entries.push({ comp: item, layer: lyr2 });
                    }
                }
            }
        }
        return { ok: true, compCount: compCount };
    }

    // ==================== 拼接 / 解析 ====================
    function buildSourceText() {
        var parts = [];
        for (var i = 0; i < entries.length; i++) {
            parts.push("<<<" + (i + 1) + ">>>");
            parts.push(getText(entries[i].layer));
        }
        return parts.join("\n");
    }

    function parseTranslated(txt) {
        var result = {};
        var regex = /<<<\s*(\d+)\s*>>>/g;
        var matches = [];
        var m;
        while ((m = regex.exec(txt)) !== null) {
            matches.push({ num: parseInt(m[1], 10), start: m.index, end: regex.lastIndex });
        }
        for (var i = 0; i < matches.length; i++) {
            var contentStart = matches[i].end;
            var contentEnd = (i + 1 < matches.length) ? matches[i + 1].start : txt.length;
            var content = txt.substring(contentStart, contentEnd);
            content = content.replace(/^[\r\n]+/, "").replace(/[\r\n]+$/, "");
            result[matches[i].num] = content;
        }
        return result;
    }

    // ==================== 刷新 ====================
    function refresh() {
        var r = collectEntries();
        if (!r.ok) {
            countLabel.text = r.msg;
            leftBox.text = "";
            return;
        }
        leftBox.text = buildSourceText();
        countLabel.text = "共 " + r.compCount + " 个合成，"
            + entries.length + " 个文本图层";
    }

    refreshBtn.onClick = function () { refresh(); };
    clearBtn.onClick = function () { rightBox.text = ""; };

    scopeDrop.onChange = function () {
        scope = (scopeDrop.selection.index === 0) ? "project" : "comp";
        refresh();
    };

    // ==================== 应用 ====================
    applyBtn.onClick = function () {
        if (entries.length === 0) {
            alert("没有可替换的文本图层，请先点“刷新”。");
            return;
        }
        var txt = rightBox.text;
        if (!txt) {
            alert("右侧译文是空的，请先粘贴译文。");
            return;
        }
        var parsed = parseTranslated(txt);
        if (parsed[1] === undefined) {
            alert("没有解析到任何译文。\n请确认右侧内容里保留了 <<<1>>>、<<<2>>> 这样的编号标记。");
            return;
        }

        // 用 undo 组包一下，方便一次撤销
        app.beginUndoGroup("批量替换文本");

        var applied = 0, failed = 0, missing = 0;
        for (var i = 0; i < entries.length; i++) {
            var num = i + 1;
            if (parsed[num] !== undefined && parsed[num] !== "") {
                if (setText(entries[i].layer, parsed[num])) applied++;
                else failed++;
            } else {
                missing++;
            }
        }

        app.endUndoGroup();

        var msg = "已应用 " + applied + " 处修改";
        if (failed) msg += "，失败 " + failed + " 处";
        msg += "。";
        if (missing) msg += "\n有 " + missing + " 个图层未找到对应译文（或译文为空），已跳过。";
        alert(msg);
    };

    // ==================== 启动 ====================
    refresh();

    if (win instanceof Window) {
        win.preferredSize = [920, 640];
        win.center();
        win.show();
    } else {
        win.layout.layout(true);
    }

})(this);